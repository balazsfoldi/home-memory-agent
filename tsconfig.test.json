{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node", "@testing-library/jest-dom"]
  },
  "include": [
    "apps/api/tests/**/*.ts",
    "apps/web/tests/**/*.ts",
    "features/steps/**/*.ts",
    "vitest.config.ts"
  ]
}
