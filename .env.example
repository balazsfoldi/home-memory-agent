# Optional LLM integration. Keep secrets here; never place them in the frontend.
# Use "none" to run the memory manager without an LLM.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OPENAI_STRUCTURED_OUTPUT=false

# The container default is /app/data. Set this to a writable local path when running locally.
DATA_PATH=./data
HOST=127.0.0.1
PORT=3000
LLM_TIMEOUT_MS=60000
