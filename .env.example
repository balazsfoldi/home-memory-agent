# Optional LLM integration. Keep secrets here; never place them in the frontend.
# Use "none" to run the memory manager without an LLM.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OPENAI_STRUCTURED_OUTPUT=false

# Optional embedding provider enables semantic search. Memory text and search queries are sent to this endpoint.
EMBEDDING_PROVIDER=none
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=30000

# The container default is /app/data. Set this to a writable local path when running locally.
DATA_PATH=./data
MEMORY_STORE=sqlite
HOST=127.0.0.1
PORT=3000
LLM_TIMEOUT_MS=60000
